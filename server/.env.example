# OAuth — create credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=
# מ-Google Cloud Console
GOOGLE_CLIENT_SECRET=
# מ-Google Cloud Console
GOOGLE_CALLBACK_URL=https://mynefesh.onrender.com/auth/google/callback
ALLOWED_GOOGLE_EMAIL=
# כתובת Gmail מורשית להתחבר (לדוגמה: dbh770@gmail.com)

# Session — generate with: openssl rand -base64 32
SESSION_SECRET=

# CORS / post-login redirect
ALLOWED_ORIGIN=https://mynefesh-danbenhurs-projects.vercel.app
FRONTEND_URL=https://mynefesh-danbenhurs-projects.vercel.app

# Twilio - SMS messaging
