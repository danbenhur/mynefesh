# אסימון אימות מ-console.twilio.com (סודי!)
TWILIO_SMS_FROM=
# מספר השולח שלך ב-Twilio (לדוגמה: +15551234567)
USER_SMS_NUMBER=
# מספר הטלפון שלך בפורמט E.164 (לדוגמה: +972XXXXXXXXX)

# Twilio - WhatsApp (deprecated — use SMS vars above)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# (deprecated) sandbox number — superseded by TWILIO_SMS_FROM
USER_WHATSAPP_NUMBER=
# (deprecated) whatsapp:+972... format — superseded by USER_SMS_NUMBER

